                    <i class="bi bi-graph-up-arrow"></i>
                </div>
                <h3 class="feature-title-modern">Seguimiento Completo</h3>
                <p class="feature-description-modern">
                    Monitorea tu progreso, peso, medidas y evolución física en tiempo real
                </p>
                <div class="feature-link">
                    <span>Conocer más</span>
                    <i class="bi bi-arrow-right"></i>
                </div>
            </div>

            <div class="feature-card-modern animate-on-scroll" style="--delay: 0.4s">
                <div class="feature-icon-modern">
                    <i class="bi bi-heart-pulse"></i>
                </div>
                <h3 class="feature-title-modern">Nutrición Integrada</h3>
                <p class="feature-description-modern">
                    Planes alimenticios personalizados que complementan tu entrenamiento
                </p>
                <div class="feature-link">
                    <span>Conocer más</span>
                    <i class="bi bi-arrow-right"></i>
                </div>
            </div>

            <div class="feature-card-modern animate-on-scroll" style="--delay: 0.5s">
                <div class="feature-icon-modern">
                    <i class="bi bi-lightning-charge"></i>
                </div>
                <h3 class="feature-title-modern">Resultados Rápidos</h3>
                <p class="feature-description-modern">
