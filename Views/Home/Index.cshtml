                        <i class="bi bi-stars"></i>
                        <span>Powered by AI</span>
                    </div>

                    <h1 class="hero-title">
                        Entrena como un
                        <span class="hero-highlight">Depredador</span>
                    </h1>

                    <p class="hero-subtitle">
                        Rutinas personalizadas con inteligencia artificial,
                        seguimiento en tiempo real y resultados garantizados.
                        <strong>Tu transformación comienza aquí.</strong>
                    </p>

                    <div class="hero-stats">
                        <div class="stat-item">
                            <span class="stat-number">10K+</span>
                            <span class="stat-label">Usuarios Activos</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-number">95%</span>
                            <span class="stat-label">Ven Resultados</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-number">4.9</span>
                            <span class="stat-label">Rating</span>
                        </div>
                    </div>

                    <div class="hero-actions">
                        @if (!SignInManager.IsSignedIn(User))
                        {
                            <a href="/Account/Register" class="btn btn-primary btn-lg hero-cta">
                                <i class="bi bi-rocket-takeoff"></i>
                                <span>Comenzar Gratis</span>
                                <div class="btn-shine"></div>
                            </a>
                            <a href="#features" class="btn btn-outline-light btn-lg hero-secondary">
                                <i class="bi bi-play-circle"></i>
                                <span>Ver Demo</span>
                            </a>
                        }
                        else
                        {
                            <a href="/Rutinas" class="btn btn-primary btn-lg hero-cta">
                                <i class="bi bi-lightning-charge"></i>
                                <span>Mis Rutinas</span>
                                <div class="btn-shine"></div>
                            </a>
                            <a href="/Perfil" class="btn btn-outline-light btn-lg hero-secondary">
                                <i class="bi bi-person-circle"></i>
                                <span>Mi Perfil</span>
                            </a>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="hero-visual animate-on-scroll">
                    <div class="visual-container">
                        <div class="floating-card card-1">
                            <i class="bi bi-heart-pulse"></i>
                            <span>Monitor Cardíaco</span>
                        </div>
                        <div class="floating-card card-2">
                            <i class="bi bi-trophy"></i>
                            <span>Objetivos Cumplidos</span>
                        </div>
                        <div class="floating-card card-3">
                            <i class="bi bi-graph-up"></i>
                            <span>Progreso Real</span>
                        </div>
                        <div class="hero-phone">
                            <div class="phone-screen">
                                <div class="app-interface">
                                    <div class="interface-header">
                                        <span>Rutina de Hoy</span>
                                        <i class="bi bi-check-circle-fill text-success"></i>
                                    </div>
                                    <div class="interface-content">
                                        <div class="progress-ring">
                                            <span>75%</span>
                                        </div>
                                        <p>¡Excelente progreso!</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

