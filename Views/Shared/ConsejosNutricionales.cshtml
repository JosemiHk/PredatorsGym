@model PredatorsGym.Models.NutritionAdviceResult

@* Vista parcial reutilizable: tarjeta de consejos nutricionales (Elite) *@

@if (Model is null)
{
    <div class="alert alert-light border small mb-0">
        <i class="bi bi-info-circle"></i> No hay datos de consejos disponibles.
    </div>
}
else if (Model.EsElegible && Model.Consejos != null && Model.Consejos.Any())
{
    <section class="card shadow-sm">
        <div class="card-header bg-warning text-dark d-flex align-items-center">
            <i class="bi bi-heart-pulse me-2" aria-hidden="true"></i>
            <strong>Consejos nutricionales personalizados (Elite)</strong>
        </div>

        <ul class="list-group list-group-flush">
            @foreach (var c in Model.Consejos)
            {
                <li class="list-group-item d-flex align-items-start gap-2 py-2">
                    <i class="bi bi-lightning-charge text-warning mt-1" aria-hidden="true"></i>
                    <span class="lh-base">@c</span>
                </li>
            }
        </ul>

        <div class="card-footer small text-muted">
            Generados por IA según tu perfil y objetivo.
        </div>
    </section>
}
else if (!Model.EsElegible)
{
    <div class="alert alert-secondary">
        <i class="bi bi-lock-fill" aria-hidden="true"></i>
        Consejos nutricionales exclusivos del plan Elite.
        <a href="/Membresia" class="alert-link">Mejora tu plan</a>.
    </div>
}
else
{
    <div class="alert alert-light border small mb-0">
        <i class="bi bi-info-circle"></i> No se encontraron consejos para mostrar.
    </div>
}