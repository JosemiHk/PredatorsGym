@model PerfilViewModel
@{
    ViewData["Title"] = "Mi Perfil";
    Layout = "_Layout";

    // Opciones para los <select>
    // A futuro, esto debería venir de un Enum o tabla de BD
    var nivelesExperiencia = new List<string> { "Principiante", "Intermedio", "Avanzado" };
    var objetivos = new List<string> { "Perder peso", "Desarrollo muscular", "Fuerza máxima", "Resistencia", "Recomposición corporal", "Salud General" };
}

@section Styles {
    <style>
        /* Layout general */
        .profile-wrapper {
            max-width: 1100px;
            margin: 0 auto;
            padding-bottom: 2rem; /* Espacio para el botón flotante */
        }

        .page-title {
            display: flex;
            gap: .75rem;
            align-items: center;
            margin-bottom: 1.5rem;
        }

            .page-title h2 {
                font-size: clamp(1.6rem, 4.5vw, 2rem);
                margin: 0;
                font-weight: 700;
            }

        /* Grid responsive */
        .form-grid {
            display: grid;
            gap: 1.25rem;
        }

        @@media (min-width: 768px) {
            .form-grid.cols-2 {
                grid-template-columns: repeat(2, 1fr);
            }

            .form-grid.cols-3 {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        /* Secciones */
        .section-card {
            background: var(--white, #fff);
            border: 1px solid var(--gray-200, #e2e8f0);
            border-radius: var(--border-radius-lg, 14px);
            box-shadow: var(--shadow-sm, 0 2px 4px rgba(0,0,0,.06));
            margin-bottom: 1.5rem;
        }

            .section-card h3 {
                font-size: 1.1rem;
                font-weight: 600;
                letter-spacing: .5px;
                margin: 0;
                display: flex;
                align-items: center;
                gap: .5rem;
                text-transform: uppercase;
                color: var(--gray-700, #374151);
                padding: 1rem 1.25rem;
                border-bottom: 1px solid var(--gray-200, #e2e8f0);
            }

                .section-card h3 i {
                    font-size: 1.2rem;
                    color: var(--primary, #EF233C);
                }

            .section-card .card-content {
                padding: 1.25rem;
            }

        /* Inputs modernos (Floating Label) */
        .floating-group {
            position: relative;
            display: flex;
            flex-direction: column;
            gap: .25rem;
        }

            .floating-group label {
                font-size: .75rem;
                font-weight: 600;
                letter-spacing: .5px;
                text-transform: uppercase;
                color: var(--gray-600, #475569);
                margin-left: 2px;
            }

            .floating-group input.form-control,
            .floating-group select.form-select,
            .floating-group textarea.form-control {
                border: 2px solid var(--gray-200, #e2e8f0);
                background: var(--gray-50, #f8fafc);
                font-size: .95rem;
                padding: .65rem .75rem;
                border-radius: 10px;
                transition: .25s;
            }

                .floating-group input.form-control:focus,
                .floating-group select.form-select:focus,
                .floating-group textarea.form-control:focus {
                    border-color: var(--primary, #EF233C);
                    background: #fff;
                    box-shadow: 0 0 0 3px rgba(239,35,60,.15);
                }

        .form-text {
            font-size: .75rem;
            margin-left: 2px;
        }

        /* Sliders */
        .slider-wrapper {
            display: flex;
            align-items: center;
            gap: .75rem;
        }

            .slider-wrapper input[type=range] {
                flex: 1;
                accent-color: var(--primary, #EF233C);
            }

        .slider-value {
            min-width: 60px;
            text-align: center;
            font-size: .8rem;
            font-weight: 600;
            background: var(--gray-100, #f1f5f9);
            padding: .35rem .55rem;
            border-radius: 6px;
            border: 1px solid var(--gray-200, #e2e8f0);
        }

        /* Upload de Imagen */
        .image-upload-wrapper {
            display: grid;
            gap: 1rem;
            align-items: center;
        }

        @@media (min-width: 576px) {
            .image-upload-wrapper {
                grid-template-columns: auto 1fr;
            }
        }

        .image-preview {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: var(--gray-100, #f1f5f9);
            border: 3px solid var(--gray-200, #e2e8f0);
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 2px 4px rgba(0,0,0,.05);
        }

            .image-preview img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

            .image-preview .preview-icon {
                font-size: 3rem;
                color: var(--gray-400, #9ca3af);
            }

        .file-input-wrapper {
            flex: 1;
        }

        .form-control[type="file"] {
            background: var(--gray-50, #f8fafc);
            border: 2px solid var(--gray-200, #e2e8f0);
            border-radius: 10px;
        }

        /* Botones de acción */
        .action-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: .75rem;
            margin-top: 1.5rem;
        }

        .btn-primary.save-btn {
            background: linear-gradient(135deg, var(--primary,#EF233C) 0%, var(--accent,#D90429) 100%);
            border: none;
            font-weight: 600;
            padding: .75rem 1.5rem;
            border-radius: 12px;
            box-shadow: 0 8px 20px -5px rgba(239,35,60,.4);
            transition: .35s;
        }

            .btn-primary.save-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 22px -6px rgba(239,35,60,.45);
            }
    </style>
}

<div class="profile-wrapper">
    <div class="page-title">
        <i class="bi bi-person-circle text-primary"></i>
        <h2>Mi Perfil</h2>
    </div>

    @if (TempData["SuccessMessage"] is string ok)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @ok
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm"></div>


    <form asp-action="Perfil" method="post" enctype="multipart/form-data" novalidate>
        @Html.AntiForgeryToken()

        <div class="section-card">
            <h3><i class="bi bi-person-badge"></i> Datos Personales</h3>
            <div class="card-content">
                <div class="form-grid cols-2">
                    <div class="floating-group">
                        <label asp-for="Nombre"></label>
                        <input asp-for="Nombre" class="form-control" />
                        <span class="text-danger small" asp-validation-for="Nombre"></span>
                    </div>
                    <div class="floating-group">
                        <label asp-for="Apellidos"></label>
                        <input asp-for="Apellidos" class="form-control" />
                        <span class="text-danger small" asp-validation-for="Apellidos"></span>
                    </div>
                    <div class="floating-group">
                        <label asp-for="Telefono"></label>
                        <input asp-for="Telefono" type="tel" class="form-control" maxlength="15" pattern="\d{0,15}" />
                        <span class="form-text">Solo dígitos. Máx. 15.</span>
                        <span class="text-danger small" asp-validation-for="Telefono"></span>
                    </div>
                    <div class="floating-group">
                        <label asp-for="FechaNacimiento"></label>
                        <input asp-for="FechaNacimiento" class="form-control" type="date" />
                        @if (Model.Edad.HasValue)
                        {
                            <span class="form-text">Edad calculada: <strong>@Model.Edad años</strong></span>
                        }
                        <span class="text-danger small" asp-validation-for="FechaNacimiento"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="section-card">
            <h3><i class="bi bi-camera"></i> Imagen de Perfil</h3>
            <div class="card-content">

                <div class="image-upload-wrapper">

                    <div class="image-preview" id="imagePreview">
                        <img src="" alt="Vista previa" id="previewImage" style="display: none;" />
                        <i class="bi bi-person-bounding-box preview-icon" id="previewIcon"></i>
                    </div>

                    <div class="file-input-wrapper floating-group">
                        <label asp-for="ImagenPerfil">Reemplazar imagen</label>
                        <input asp-for="ImagenPerfil" class="form-control" type="file" accept=".jpg,.jpeg,.png,.gif,.webp" id="fileUpload" />
                        <span class="form-text">Max 5MB. Formatos: JPG, PNG, GIF, WebP.</span>
                        <span class="text-danger small" asp-validation-for="ImagenPerfil"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="section-card">
            <h3><i class="bi bi-rulers"></i> Métricas Físicas</h3>
            <div class="card-content">
                <div class="form-grid cols-3">
                    <div class="floating-group">
                        <label asp-for="Altura">Altura (cm)</label>
                        <div class="slider-wrapper">
                            <input asp-for="Altura" type="range" min="100" max="250" step="1" />
                            <div class="slider-value" id="valAltura"></div>
                        </div>
                        <span class="text-danger small" asp-validation-for="Altura"></span>
                    </div>
                    <div class="floating-group">
                        <label asp-for="PesoActual">Peso Actual (kg)</label>
                        <div class="slider-wrapper">
                            <input asp-for="PesoActual" type="range" min="30" max="250" step="0.5" />
                            <div class="slider-value" id="valPesoActual"></div>
                        </div>
                        <span class="text-danger small" asp-validation-for="PesoActual"></span>
                    </div>
                    <div class="floating-group">
                        <label asp-for="PesoObjetivo">Peso Objetivo (kg)</label>
                        <div class="slider-wrapper">
                            <input asp-for="PesoObjetivo" type="range" min="30" max="250" step="0.5" />
                            <div class="slider-value" id="valPesoObj"></div>
                        </div>
                        <span class="text-danger small" asp-validation-for="PesoObjetivo"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="section-card">
            <h3><i class="bi bi-flag"></i> Objetivos y Preferencias</h3>
            <div class="card-content">
                <div class="form-grid cols-2">
                    <div class="floating-group">
                        <label asp-for="NivelExperiencia"></label>
                        <select asp-for="NivelExperiencia" class="form-select">
                            <option value="">Seleccione...</option>
                            @foreach (var nivel in nivelesExperiencia)
                            {
                                <option>@nivel</option>
                            }
                        </select>
                        <span class="text-danger small" asp-validation-for="NivelExperiencia"></span>
                    </div>
                    <div class="floating-group">
                        <label asp-for="ObjetivoPrincipal"></label>
                        <select asp-for="ObjetivoPrincipal" class="form-select">
                            <option value="">Seleccione...</option>
                            @foreach (var objetivo in objetivos)
                            {
                                <option>@objetivo</option>
                            }
                        </select>
                        <span class="text-danger small" asp-validation-for="ObjetivoPrincipal"></span>
                    </div>
                    <div class="floating-group">
                        <label asp-for="DiasEntrenamientoSemana">Días por Semana</label>
                        <div class="slider-wrapper">
                            <input asp-for="DiasEntrenamientoSemana" type="range" min="1" max="7" step="1" />
                            <div class="slider-value" id="valDias"></div>
                        </div>
                        <span class="text-danger small" asp-validation-for="DiasEntrenamientoSemana"></span>
                    </div>
                    <div class="floating-group">
                        <label asp-for="DuracionPreferida">Duración (min)</label>
                        <div class="slider-wrapper">
                            <input asp-for="DuracionPreferida" type="range" min="15" max="120" step="5" />
                            <div class="slider-value" id="valDuracion"></div>
                        </div>
                        <span class="text-danger small" asp-validation-for="DuracionPreferida"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="section-card">
            <h3><i class="bi bi-info-circle"></i> Información Adicional</h3>
            <div class="card-content">
                <div class="floating-group">
                    <label asp-for="LesionesLimitaciones"></label>
                    <textarea asp-for="LesionesLimitaciones" class="form-control" rows="3"></textarea>
                    <span class="form-text">Indica cualquier condición que debamos considerar.</span>
                    <span class="text-danger small" asp-validation-for="LesionesLimitaciones"></span>
                </div>
            </div>
        </div>

        <div class="action-buttons">
            <button type="submit" class="btn btn-primary save-btn">
                <i class="bi bi-save"></i> Guardar Cambios
            </button>
            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">
                <i class="bi bi-house"></i> Ir al Inicio
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Sincroniza y muestra valores actuales de sliders
        function syncValue(selector, targetId, suffix = "") {
            const el = document.querySelector(selector);
            const box = document.getElementById(targetId);
            if (!el || !box) return;
            const update = () => box.textContent = el.value + suffix;
            el.addEventListener('input', update);
            update(); // Cargar valor inicial
        }

        // Vista previa de imagen de perfil
        function setupImagePreview() {
            const fileInput = document.getElementById('fileUpload');
            const previewImg = document.getElementById('previewImage');
            const previewIcon = document.getElementById('previewIcon');

            if (!fileInput || !previewImg || !previewIcon) return;

            fileInput.addEventListener('change', function () {
                const file = this.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        previewImg.src = e.target.result;
                        previewImg.style.display = 'block';
                        previewIcon.style.display = 'none';
                    };
                    reader.readAsDataURL(file);
                }
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            // Inicializar sliders
            syncValue('input[name="Altura"]', 'valAltura', ' cm');
            syncValue('input[name="PesoActual"]', 'valPesoActual', ' kg');
            syncValue('input[name="PesoObjetivo"]', 'valPesoObj', ' kg');
            syncValue('input[name="DiasEntrenamientoSemana"]', 'valDias', ' días');
            syncValue('input[name="DuracionPreferida"]', 'valDuracion', ' min');

            // Inicializar vista previa de imagen
            setupImagePreview();
        });
    </script>
}