@model PredatorsGym.Models.Rutina
@using PredatorsGym.Models
@{
    ViewData["Title"] = "Rutina Generada";
    Layout = "_Layout";
    var consejos = ViewBag.ConsejosNutricion as NutritionAdviceResult;
}

<div class="container py-3">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item">
                <a href="@Url.Action("Index", "Home")" class="text-decoration-none">
                    <i class="bi bi-house"></i> Inicio
                </a>
            </li>
            <li class="breadcrumb-item">
                <a href="@Url.Action("Index", "Rutinas")" class="text-decoration-none">
                    <i class="bi bi-lightning-charge"></i> Mis Rutinas
                </a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">Rutina Generada</li>
        </ol>
    </nav>

    <div class="row g-3">
        <!-- Rutina -->
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <h5 class="mb-0"><i class="bi bi-star-fill text-warning"></i> Tu Rutina Personalizada</h5>
                        <small class="text-muted">Creada el @Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</small>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="@Url.Action("Create")" class="btn btn-primary btn-sm">
                            <i class="bi bi-plus-circle"></i> Nueva Rutina
                        </a>
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-list-task"></i> Mis Rutinas
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <!-- Stats -->
                    <div class="row g-2 mb-3">
                        <div class="col-6 col-md-3">
                            <div class="border rounded p-2 h-100">
                                <div class="small text-muted">IMC</div>
                                <div class="fw-bold">@Model.IMC.ToString("F1")</div>
                                <div><span class="badge bg-info">@Model.EstadoIMC</span></div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="border rounded p-2 h-100">
                                <div class="small text-muted">Objetivo</div>
                                <div class="fw-bold text-truncate" title="@Model.Objetivo">@Model.Objetivo</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="border rounded p-2 h-100">
                                <div class="small text-muted">Nivel</div>
                                <div class="fw-bold">@Model.Experiencia</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="border rounded p-2 h-100">
                                <div class="small text-muted">Días/Semana</div>
                                <div class="fw-bold">@Model.DiasEntrenamiento</div>
                            </div>
                        </div>
                    </div>

                    <!-- Lista de ejercicios (si existen) -->
                    @if (Model.Ejercicios != null && Model.Ejercicios.Any())
                    {
                        <h6 class="mb-2"><i class="bi bi-clipboard-check"></i> Plan de ejercicios</h6>
                        <ul class="list-group list-group-flush">
                            @foreach (var e in Model.Ejercicios.OrderBy(x => x.Orden))
                            {
                                <li class="list-group-item">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <div class="fw-semibold">@e.Nombre</div>
                                            @if (!string.IsNullOrWhiteSpace(e.Descripcion))
                                            {
                                                <div class="small text-muted">@e.Descripcion</div>
                                            }
                                        </div>
                                        <span class="badge bg-primary align-self-center">
                                            @e.Series × @e.Repeticiones
                                        </span>
                                    </div>
                                    <div class="mt-1 small text-muted d-flex flex-wrap gap-3">
                                        <span><i class="bi bi-stopwatch"></i> Duración estimada: @e.DuracionEstimada s</span>
                                        <span><i class="bi bi-hourglass-split"></i> Descanso: @e.TiempoDescanso s</span>
                                        <span><i class="bi bi-hash"></i> Orden: @e.Orden</span>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <!-- Fallback: texto de la rutina generada -->
                        <h6 class="mb-2"><i class="bi bi-clipboard-check"></i> Detalle de la rutina</h6>
                        @if (!string.IsNullOrWhiteSpace(Model.RutinaGenerada))
                        {
                            <pre class="bg-light p-3 rounded" style="white-space: pre-wrap">@Model.RutinaGenerada</pre>
                        }
                        else
                        {
                            <div class="alert alert-warning mb-0">
                                <i class="bi bi-exclamation-triangle"></i> No hay contenido de rutina disponible.
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Consejos nutricionales -->
        <div class="col-12 col-lg-4">
            @if (consejos?.EsElegible == true && consejos.Consejos?.Count > 0)
            {
                <section class="card shadow-sm">
                    <div class="card-header bg-warning text-dark d-flex align-items-center">
                        <i class="bi bi-heart-pulse me-2"></i>
                        <strong>Consejos nutricionales personalizados (Elite)</strong>
                    </div>
                    <ul class="list-group list-group-flush">
                        @foreach (var c in consejos.Consejos)
                        {
                            <li class="list-group-item d-flex">
                                <i class="bi bi-lightning-charge text-warning me-2 mt-1"></i>
                                <span>@c</span>
                            </li>
                        }
                    </ul>
                    <div class="card-footer small text-muted">
                        Generados por IA según tu perfil y objetivo.
                    </div>
                </section>
            }
            else if (consejos != null && !consejos.EsElegible)
            {
                <div class="alert alert-secondary">
                    <i class="bi bi-lock-fill"></i> Consejos nutricionales exclusivos del plan Elite.
                    <a href="/Membresia" class="alert-link">Mejora tu plan</a>.
                </div>
            }

            <!-- Resumen lateral -->
            <div class="card mt-3">
                <div class="card-header">
                    <i class="bi bi-graph-up"></i> Resumen
                </div>
                <div class="card-body">
                    <div class="mb-2"><strong>Objetivo:</strong> @Model.Objetivo</div>
                    <div class="mb-2"><strong>Nivel:</strong> @Model.Experiencia</div>
                    <div class="mb-2"><strong>Días/Semana:</strong> @Model.DiasEntrenamiento</div>
                    <div class="mb-2"><strong>IMC:</strong> @Model.IMC.ToString("F1") (@Model.EstadoIMC)</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Acciones principales (mobile-first) -->
    <div class="d-grid gap-2 d-sm-flex justify-content-sm-end mt-3">
        <a href="@Url.Action("Create")" class="btn btn-primary btn-lg">
            <i class="bi bi-rocket-takeoff"></i> Generar nueva rutina
        </a>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-lg">
            <i class="bi bi-list-task"></i> Ver mis rutinas
        </a>
    </div>
</div>