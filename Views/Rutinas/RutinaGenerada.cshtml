@model PredatorsGym.Models.Rutina
@{
    ViewData["Title"] = "Rutina Generada";
    Layout = "_Layout";
}
@section Styles {
    <link rel="stylesheet" href="~/css/rutina.css" asp-append-version="true" />
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">📋 Tu Rutina Personalizada</h4>
                    <div>
                        <button id="startWorkoutBtn" class="btn btn-success btn-lg me-2">
                            🏋️ Comenzar Entrenamiento
                        </button>
                        <button id="pauseWorkoutBtn" class="btn btn-warning" style="display: none;">
                            ⏸️ Pausar
                        </button>
                        <button id="resumeWorkoutBtn" class="btn btn-info" style="display: none;">
                            ▶️ Reanudar
                        </button>
                        <button id="stopWorkoutBtn" class="btn btn-danger" style="display: none;">
                            ⏹️ Detener
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model != null)
                    {
                        <div class="row mb-3">
                            <div class="col-md-3">
                                <strong>📊 IMC:</strong> @Model.IMC.ToString("F1") (@Model.EstadoIMC)
                            </div>
                            <div class="col-md-3">
                                <strong>🎯 Objetivo:</strong> @Model.Objetivo
                            </div>
                            <div class="col-md-3">
                                <strong>💪 Experiencia:</strong> @Model.Experiencia
                            </div>
                            <div class="col-md-3">
                                <strong>📅 Días/semana:</strong> @Model.DiasEntrenamiento
                            </div>
                        </div>

                        <div class="rutina-content">
                            @if (!string.IsNullOrEmpty(Model.RutinaGenerada))
                            {
                                <pre class="bg-light p-3 rounded">@Model.RutinaGenerada</pre>
                            }
                            else
                            {
                                <div class="alert alert-warning">
                                    <strong>⚠️ Rutina vacía:</strong> No se pudo cargar el contenido de la rutina.
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-danger">
                            <strong>❌ Error:</strong> No se pudo cargar la rutina. El modelo está vacío.
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">🎧 Control de Entrenamiento</h5>
                </div>
                <div class="card-body">
                    <!-- Estado del entrenamiento -->
                    <div id="workoutStatus" class="alert alert-info">
                        <strong>Estado:</strong> <span id="statusText">Listo para comenzar</span>
                    </div>

                    <!-- Ejercicio actual -->
                    <div id="currentExercise" style="display: none;">
                        <h6>📍 Ejercicio Actual:</h6>
                        <div class="card bg-primary text-white mb-3">
                            <div class="card-body">
                                <h5 id="exerciseName">-</h5>
                                <p id="exerciseDetails" class="mb-0">-</p>
                            </div>
                        </div>
                    </div>

                    <!-- Timer/Contador -->
                    <div id="workoutTimer" style="display: none;">
                        <h6>⏱️ Tiempo:</h6>
                        <div class="text-center">
                            <span id="timerDisplay" class="h4 text-primary">00:00</span>
                        </div>
                    </div>

                    <!-- Descanso -->
                    <div id="restTimer" style="display: none;" class="text-center">
                        <h6>😴 Tiempo de Descanso:</h6>
                        <div class="text-center">
                            <span id="restDisplay" class="h4 text-warning">00:00</span>
                        </div>
                    </div>

                    <!-- Control de volumen -->
                    <div class="mb-3">
                        <label for="volumeControl" class="form-label">🔊 Volumen:</label>
                        <input type="range" class="form-range" id="volumeControl" min="0" max="100" value="70">
                        <audio id="workoutAudio" preload="metadata"></audio>
                    </div>

                    <!-- Log de mensajes -->
                    <div id="workoutLog" class="mt-3">
                        <h6>📝 Log de Entrenamiento:</h6>
                        <div id="logContent" class="border rounded p-2" style="height: 200px; overflow-y: auto; background-color: #f8f9fa;">
                            <small class="text-muted">Los mensajes de entrenamiento aparecerán aquí...</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a class="btn btn-secondary" asp-action="Create">🔄 Generar Nueva Rutina</a>
    <a class="btn btn-info" asp-action="Index">📊 Mis Rutinas</a>
</div>

<!-- Debug Info (solo en desarrollo) -->
@if (Context.Request.Host.Host == "localhost")
{
    <div class="mt-4 p-3 border rounded bg-light">
        <h6>🔧 Información de Debug:</h6>
        <ul>
            <li><strong>Modelo nulo:</strong> @(Model == null ? "SÍ" : "NO")</li>
            @if (Model != null)
            {
                <li><strong>ID de Rutina:</strong> @Model.Id</li>
                <li><strong>Usuario ID:</strong> @Model.UsuarioId</li>
                <li><strong>Fecha Creación:</strong> @Model.FechaCreacion</li>
                <li><strong>Longitud Rutina:</strong> @(Model.RutinaGenerada?.Length ?? 0) caracteres</li>
                <li><strong>Rutina vacía:</strong> @(string.IsNullOrEmpty(Model.RutinaGenerada) ? "SÍ" : "NO")</li>
            }
        </ul>
    </div>
}


@section Scripts {
    <!--  CDN de SignalR -->
    <script src="~/lib/microsoft-signalr/signalr.min.js"></script>
    <script>
        // Variables globales
        let connection;
        let workoutTimer;
        let restTimer;
        let currentRoutineId = @(Model?.Id ?? 0);
        let workoutStartTime;
        let isWorkoutActive = false;

        console.log('🔧 Debug Info:', {
            modelId: currentRoutineId,
            modelNull: @(Model == null ? "true" : "false"),
            rutinaLength: @(Model?.RutinaGenerada?.Length ?? 0)
        });

        //  INICIALIZACIÓN CON VALIDACIÓN MEJORADA
        document.addEventListener('DOMContentLoaded', function() {
            logMessage("🔧 Página cargada. Inicializando...");

            if (currentRoutineId > 0) {
                initializeSignalR();
            } else {
                console.warn('⚠️ No se puede inicializar SignalR: ID de rutina inválido');
                logMessage("❌ No se puede conectar: rutina no válida", 'error');
            }

            // Configurar controles
            setupEventListeners();
        });

        //  INICIALIZACIÓN SIGNALR MEJORADA
        async function initializeSignalR() {
            try {
                logMessage("🔗 Iniciando conexión SignalR...");

                connection = new signalR.HubConnectionBuilder()
                    .withUrl("/workoutHub", {
                        transport: signalR.HttpTransportType.WebSockets | signalR.HttpTransportType.LongPolling
                    })
                    .withAutomaticReconnect([0, 2000, 10000, 30000])
                    .configureLogging(signalR.LogLevel.Information)
                    .build();

                //  EVENTOS DEL HUB
                connection.on("ReceiveAudio", function (audioData) {
                    console.log("🎵 Audio recibido, tamaño:", audioData.length);
                    playAudio(audioData);
                    logMessage("🎵 Reproduciendo instrucciones de audio...");
                });

                connection.on("ReceiveExerciseStart", function (exercise) {
                    console.log("🏁 Ejercicio iniciado:", exercise);
                    showCurrentExercise(exercise);
                    logMessage(`🏁 Iniciando: ${exercise.Name} (${exercise.Series}x${exercise.Repetitions})`);
                });

                connection.on("ReceiveExerciseEnd", function (exercise) {
                    console.log("✅ Ejercicio completado:", exercise);
                    logMessage(`✅ Completado: ${exercise.Name}`);
                });

                connection.on("ReceiveRestTime", function (rest) {
                    console.log("😴 Tiempo de descanso:", rest);
                    startRestTimer(rest.Duration);
                    logMessage(`😴 Descanso: ${rest.Duration} segundos`);
                });

                connection.on("ReceiveWorkoutCompleted", function (data) {
                    console.log("🎉 Entrenamiento completado:", data);
                    completeWorkout(data);
                    logMessage(`🎉 ¡Entrenamiento completado! Duración: ${data.Duration.toFixed(1)} minutos`);
                });

                connection.on("ReceiveWorkoutPaused", function () {
                    console.log("⏸️ Entrenamiento pausado");
                    pauseWorkout();
                    logMessage("⏸️ Entrenamiento pausado");
                });

                connection.on("ReceiveWorkoutResumed", function () {
                    console.log("▶️ Entrenamiento reanudado");
                    resumeWorkout();
                    logMessage("▶️ Entrenamiento reanudado");
                });

                connection.on("ReceiveError", function (message) {
                    console.error("❌ Error desde hub:", message);
                    logMessage(`❌ Error: ${message}`, 'error');
                    showError(message);
                });

                connection.on("Connected", function (connectionId) {
                    console.log("✅ Conectado con ID:", connectionId);
                    logMessage(`✅ Conectado con ID: ${connectionId}`);
                });

                // ✅ EVENTOS DE RECONEXIÓN
                connection.onreconnecting((error) => {
                    console.warn("🔄 Reconectando...", error);
                    logMessage("🔄 Reconectando...", 'warning');
                });

                connection.onreconnected((connectionId) => {
                    console.log("✅ Reconectado con ID:", connectionId);
                    logMessage("✅ Reconectado exitosamente");
                });

                connection.onclose((error) => {
                    console.error("❌ Conexión cerrada:", error);
                    logMessage("❌ Conexión perdida", 'error');
                });

                // ✅ INICIAR CONEXIÓN
                await connection.start();
                logMessage("🔗 Conectado al servidor de entrenamiento");

                // Unirse al grupo de la rutina
                await connection.invoke("JoinWorkoutGroup", currentRoutineId.toString());
                logMessage(`👥 Unido al grupo de rutina ${currentRoutineId}`);

            } catch (err) {
                console.error("❌ Error al conectar SignalR:", err);
                logMessage(`❌ Error de conexión: ${err}`, 'error');

                // Retry después de 5 segundos
                setTimeout(() => {
                    logMessage("🔄 Reintentando conexión...");
                    initializeSignalR();
                }, 5000);
            }
        }

        //  FUNCIÓN DE REPRODUCCIÓN DE AUDIO MEJORADA
        function playAudio(base64Data) {
            try {
                console.log("🎵 Intentando reproducir audio, tamaño:", base64Data.length);

                const audio = document.getElementById('workoutAudio');
                const volume = document.getElementById('volumeControl').value / 100;

                // Limpiar src anterior
                if (audio.src) {
                    URL.revokeObjectURL(audio.src);
                }

                // Crear blob de audio
                const binaryString = atob(base64Data);
                const bytes = new Uint8Array(binaryString.length);
                for (let i = 0; i < binaryString.length; i++) {
                    bytes[i] = binaryString.charCodeAt(i);
                }

                const blob = new Blob([bytes], { type: 'audio/mp3' });
                const url = URL.createObjectURL(blob);

                audio.src = url;
                audio.volume = volume;

                // Reproducir con promesa
                const playPromise = audio.play();

                if (playPromise !== undefined) {
                    playPromise
                        .then(() => {
                            console.log("✅ Audio reproducido exitosamente");
                            logMessage("✅ Audio reproducido");
                        })
                        .catch(error => {
                            console.error("❌ Error al reproducir audio:", error);
                            logMessage(`❌ Error de audio: ${error.message}`, 'error');
                        });
                }

            } catch (error) {
                console.error("❌ Error al procesar audio:", error);
                logMessage(`❌ Error de audio: ${error}`, 'error');
            }
        }

        //  CONFIGURAR EVENT LISTENERS
        function setupEventListeners() {
            // Botón de inicio
            document.getElementById('startWorkoutBtn')?.addEventListener('click', async function() {
                if (currentRoutineId <= 0) {
                    logMessage("❌ No se puede iniciar: ID de rutina inválido", 'error');
                    return;
                }

                logMessage(`🚀 Intentando iniciar entrenamiento con rutina ID: ${currentRoutineId}`);

                try {
                    const response = await fetch(`/api/workout/start/${currentRoutineId}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() || ''
                        }
                    });

                    if (response.ok) {
                        const result = await response.json();
                        logMessage("✅ Entrenamiento iniciado exitosamente");
                        console.log("✅ Respuesta del servidor:", result);
                    } else {
                        const errorText = await response.text();
                        console.error("❌ Error del servidor:", response.status, errorText);
                        logMessage(`❌ Error al iniciar (${response.status}): ${errorText}`, 'error');
                    }
                } catch (error) {
                    console.error("❌ Error de red:", error);
                    logMessage(`❌ Error de conexión: ${error}`, 'error');
                }
            });

            // Control de volumen
            document.getElementById('volumeControl')?.addEventListener('input', function() {
                const audio = document.getElementById('workoutAudio');
                if (audio) {
                    audio.volume = this.value / 100;
                    logMessage(`🔊 Volumen ajustado a ${this.value}%`);
                }
            });
        }

        //  FUNCIONES AUXILIARES MEJORADAS
        function logMessage(message, type = 'info') {
            const logContent = document.getElementById('logContent');
            if (!logContent) return;

            const timestamp = new Date().toLocaleTimeString();
            const messageClass = type === 'error' ? 'text-danger' :
                                type === 'warning' ? 'text-warning' : 'text-dark';

            logContent.innerHTML += `
                <div class="${messageClass}">
                    <small class="text-muted">[${timestamp}]</small> ${message}
                </div>
            `;

            logContent.scrollTop = logContent.scrollHeight;

            // También log en consola
            if (type === 'error') {
                console.error(message);
            } else if (type === 'warning') {
                console.warn(message);
            } else {
                console.log(message);
            }
        }

        function showError(message) {
            const statusDiv = document.getElementById('workoutStatus');
            if (statusDiv) {
                statusDiv.className = 'alert alert-danger';
                statusDiv.innerHTML = `<strong>Error:</strong> ${message}`;
            }
        }

        function showCurrentExercise(exercise) {
            const currentExerciseDiv = document.getElementById('currentExercise');
            if (currentExerciseDiv) {
                currentExerciseDiv.style.display = 'block';
                document.getElementById('exerciseName').textContent = exercise.Name;
                document.getElementById('exerciseDetails').textContent =
                    `${exercise.Series} series × ${exercise.Repetitions} repeticiones`;
            }
        }

        function startRestTimer(duration) {
            const restTimerDiv = document.getElementById('restTimer');
            if (restTimerDiv) {
                restTimerDiv.style.display = 'block';
                let remaining = duration;

                restTimer = setInterval(function() {
                    const minutes = Math.floor(remaining / 60);
                    const seconds = remaining % 60;
                    document.getElementById('restDisplay').textContent =
                        `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;

                    remaining--;
                    if (remaining < 0) {
                        clearInterval(restTimer);
                        restTimerDiv.style.display = 'none';
                    }
                }, 1000);
            }
        }

        function completeWorkout(data) {
            // Implementar lógica de finalización
            logMessage("🏆 Entrenamiento finalizado");
        }

        function pauseWorkout() {
            // Implementar lógica de pausa
            logMessage("⏸️ Entrenamiento pausado");
        }

        function resumeWorkout() {
            // Implementar lógica de reanudación
            logMessage("▶️ Entrenamiento reanudado");
        }

        //  CLEANUP AL SALIR
        window.addEventListener('beforeunload', async function() {
            if (connection && connection.state === signalR.HubConnectionState.Connected) {
                try {
                    await connection.invoke("LeaveWorkoutGroup", currentRoutineId.toString());
                    await connection.stop();
                } catch (err) {
                    console.error("Error al limpiar conexión:", err);
                }
            }
        });
    </script>
}