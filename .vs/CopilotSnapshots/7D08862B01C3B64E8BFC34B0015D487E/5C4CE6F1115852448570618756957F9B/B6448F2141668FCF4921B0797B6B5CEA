using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Identity;
using Microsoft.AspNetCore.Mvc;
using Microsoft.EntityFrameworkCore;
using PredatorsGym.Datos;
using PredatorsGym.Models;
using PredatorsGym.Servicios;

namespace PredatorsGym.Controllers
{
    [Authorize]
    public class MembresiaController : Controller
    {
        private readonly UserManager<IdentityUser> _userManager;
        private readonly ApplicationDbContext _context;
        private readonly IMercadoPagoService _mp;
        private readonly ILogger<MembresiaController> _logger;

        public MembresiaController(UserManager<IdentityUser> userManager, ApplicationDbContext context, IMercadoPagoService mp, ILogger<MembresiaController> logger)
        {
            _userManager = userManager;
            _context = context;
            _mp = mp;
            _logger = logger;
        }

        [HttpGet]
        public async Task<IActionResult> Index()
        {
            var user = await _userManager.GetUserAsync(User);
            if (user == null)
            {
                return RedirectToAction("Login", "Account");
            }

            var membresiaActual = await _context.Membresias
                .Where(m => m.UsuarioId == user.Id && m.EsActiva)
                .OrderByDescending(m => m.FechaCreacion)
                .FirstOrDefaultAsync();

            var historialMembresias = await _context.Membresias
                .Where(m => m.UsuarioId == user.Id)
                .OrderByDescending(m => m.FechaCreacion)
                .ToListAsync();

            var planesDisponibles = ObtenerPlanesDisponibles();

            ViewBag.MembresiaActual = membresiaActual;
            ViewBag.HistorialMembresias = historialMembresias;
            ViewBag.PlanesDisponibles = planesDisponibles;

            return View();
        }

        [HttpPost]
        [ValidateAntiForgeryToken]
        public async Task<IActionResult> SuscribirPlan(string tipoPlan, string duracion)
        {
            var user = await _userManager.GetUserAsync(User);
            if (user == null)
            {
                return RedirectToAction("Login", "Account");
            }

            try
            {
                var planes = ObtenerPlanesDisponibles();
                var planSeleccionado = planes.FirstOrDefault(p => p.Nombre.Equals(tipoPlan, StringComparison.OrdinalIgnoreCase));
                if (planSeleccionado == null)
                {
                    TempData["ErrorMessage"] = "Plan no válido seleccionado.";
                    return RedirectToAction("Index");
                }

                var precio = duracion == "anual" ? planSeleccionado.PrecioAnual : planSeleccionado.PrecioMensual;
                var meses = duracion == "anual" ? 12 : 1;

                var baseUrl = $"{Request.Scheme}://{Request.Host}";
                var preference = await _mp.CreatePreferenceAsync(tipoPlan, duracion, precio, user.Id, user.Email, baseUrl);

                var preliminar = new Membresia
                {
                    UsuarioId = user.Id,
                    TipoMembresia = tipoPlan,
                    Precio = precio,
                    FechaInicio = DateTime.Now,
                    FechaFin = DateTime.Now.AddMonths(meses),
                    EsActiva = false,
                    MetodoPago = "MercadoPago",
                    TransaccionId = preference.Id // guardamos preference_id para luego localizarla
                };
                _context.Membresias.Add(preliminar);
                await _context.SaveChangesAsync();

                return Redirect(preference.InitPoint);
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error al crear preferencia de Mercado Pago");
                TempData["ErrorMessage"] = "Error al procesar la suscripción.";
                return RedirectToAction("Index");
            }
        }

        [HttpPost]
        [ValidateAntiForgeryToken]
        public async Task<IActionResult> MejorarPlan(string planObjetivo, string duracion)
        {
            var user = await _userManager.GetUserAsync(User);
            if (user == null) return RedirectToAction("Login", "Account");

            try
            {
                var planes = ObtenerPlanesDisponibles();
                var planDestino = planes.FirstOrDefault(p => p.Nombre.Equals(planObjetivo, StringComparison.OrdinalIgnoreCase));
                if (planDestino == null)
                {
                    TempData["ErrorMessage"] = "Plan destino no válido.";
                    return RedirectToAction("Index");
                }

                var membresiaActual = await _context.Membresias
                    .Where(m => m.UsuarioId == user.Id && m.EsActiva)
                    .OrderByDescending(m => m.FechaCreacion)
                    .FirstOrDefaultAsync();

                var precioDestino = duracion == "anual" ? planDestino.PrecioAnual : planDestino.PrecioMensual;
                var precioConProrrateo = CalcularPrecioUpgrade(membresiaActual, precioDestino);
                if (precioConProrrateo < 0) precioConProrrateo = 0;

                var baseUrl = $"{Request.Scheme}://{Request.Host}";
                var preference = await _mp.CreatePreferenceAsync(planObjetivo, duracion, precioConProrrateo, user.Id, user.Email, baseUrl);

                // Registro preliminar de la nueva membresía a activar al aprobar
                var meses = duracion == "anual" ? 12 : 1;
                var preliminar = new Membresia
                {
                    UsuarioId = user.Id,
                    TipoMembresia = planObjetivo,
                    Precio = precioConProrrateo,
                    FechaInicio = DateTime.Now,
                    FechaFin = DateTime.Now.AddMonths(meses),
                    EsActiva = false,
                    MetodoPago = "MercadoPago",
                    TransaccionId = preference.Id
                };
                _context.Membresias.Add(preliminar);
                await _context.SaveChangesAsync();

                return Redirect(preference.InitPoint);
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error al mejorar plan");
                TempData["ErrorMessage"] = "No se pudo iniciar la mejora del plan.";
                return RedirectToAction("Index");
            }
        }

        [HttpGet]
        public async Task<IActionResult> PaymentReturn(string status, string? preference_id = null, string? payment_id = null)
        {
            var user = await _userManager.GetUserAsync(User);
            if (user == null)
            {
                return RedirectToAction("Login", "Account");
            }

            try
            {
                if (!string.IsNullOrEmpty(payment_id))
                {
                    var payment = await _mp.GetPaymentAsync(payment_id);
                    if (payment != null && payment.Status.Equals("approved", StringComparison.OrdinalIgnoreCase))
                    {
                        // Usar el preference_id para encontrar el preliminar creado
                        await ActivarMembresiaAsync(user.Id, preference_id, payment.Id);
                        TempData["SuccessMessage"] = "¡Pago aprobado! Tu membresía está activa.";
                        return RedirectToAction("Index");
                    }
                }

                if (string.Equals(status, "success", StringComparison.OrdinalIgnoreCase))
                {
                    await ActivarMembresiaAsync(user.Id, preference_id, payment_id);
                    TempData["SuccessMessage"] = "Pago completado. Tu membresía ha sido activada.";
                }
                else if (string.Equals(status, "pending", StringComparison.OrdinalIgnoreCase))
                {
                    TempData["ErrorMessage"] = "Pago pendiente de aprobación.";
                }
                else
                {
                    TempData["ErrorMessage"] = "Pago cancelado o rechazado.";
                }
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error al procesar retorno de pago");
                TempData["ErrorMessage"] = "No se pudo verificar el pago.";
            }
            return RedirectToAction("Index");
        }

        [HttpPost]
        [ValidateAntiForgeryToken]
        public async Task<IActionResult> CancelarMembresia()
        {
            var user = await _userManager.GetUserAsync(User);
            if (user == null)
            {
                return RedirectToAction("Login", "Account");
            }

            var membresiaActiva = await _context.Membresias
                .Where(m => m.UsuarioId == user.Id && m.EsActiva)
                .FirstOrDefaultAsync();

            if (membresiaActiva != null)
            {
                membresiaActiva.EsActiva = false;
                membresiaActiva.FechaCancelacion = DateTime.Now;
                membresiaActiva.NotasCancelacion = "Cancelada por el usuario";

                await _context.SaveChangesAsync();
                TempData["SuccessMessage"] = "Membresía cancelada exitosamente.";
            }
            else
            {
                TempData["ErrorMessage"] = "No tienes una membresía activa para cancelar.";
            }

            return RedirectToAction("Index");
        }

        private async Task ActivarMembresiaAsync(string userId, string? preferenceId, string? paymentId)
        {
            // Desactivar membresía activa actual
            var activa = await _context.Membresias.Where(m => m.UsuarioId == userId && m.EsActiva).FirstOrDefaultAsync();
            if (activa != null)
            {
                activa.EsActiva = false;
                activa.FechaCancelacion = DateTime.Now;
                activa.NotasCancelacion = "Reemplazada por nueva membresía";
            }

            // Buscar registro preliminar por preference_id almacenado en TransaccionId
            Membresia? preliminar = null;
            if (!string.IsNullOrEmpty(preferenceId))
            {
                preliminar = await _context.Membresias
                    .Where(m => m.UsuarioId == userId && !m.EsActiva && m.TransaccionId == preferenceId)
                    .OrderByDescending(m => m.FechaCreacion)
                    .FirstOrDefaultAsync();
            }

            // Fallback: tomar el último preliminar del usuario
            preliminar ??= await _context.Membresias
                .Where(m => m.UsuarioId == userId && !m.EsActiva)
                .OrderByDescending(m => m.FechaCreacion)
                .FirstOrDefaultAsync();

            if (preliminar != null)
            {
                preliminar.EsActiva = true;
                preliminar.MetodoPago = "MercadoPago";
                preliminar.TransaccionId = paymentId ?? preliminar.TransaccionId;
            }

            await _context.SaveChangesAsync();
        }

        private static decimal CalcularPrecioUpgrade(Membresia? actual, decimal precioDestino)
        {
            if (actual == null || !actual.EsActiva) return precioDestino;

            var total = (decimal)(actual.FechaFin - actual.FechaInicio).TotalDays;
            var restantes = (decimal)(actual.FechaFin - DateTime.Now).TotalDays;
            if (total <= 0 || restantes <= 0) return precioDestino;

            var proporcion = Math.Clamp(restantes / total, 0m, 1m);
            var credito = actual.Precio * proporcion; // valor no usado del plan actual
            var final = precioDestino - credito;
            return final < 0 ? 0 : Math.Round(final, 2);
        }

