using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Identity;
using Microsoft.AspNetCore.Mvc;
using Microsoft.EntityFrameworkCore;
using PredatorsGym.Datos;
using PredatorsGym.Models;

namespace PredatorsGym.Controllers
{
    [Authorize]
    public class MembresiaController : Controller
    {
        private readonly UserManager<IdentityUser> _userManager;
        private readonly ApplicationDbContext _context;

        public MembresiaController(UserManager<IdentityUser> userManager, ApplicationDbContext context)
        {
            _userManager = userManager;
            _context = context;
        }

        [HttpGet]
        public async Task<IActionResult> Index()
        {
            var user = await _userManager.GetUserAsync(User);
            if (user == null)
            {
                return RedirectToAction("Login", "Account");
            }

            // Obtener membresía actual del usuario
            var membresiaActual = await _context.Membresias
                .Where(m => m.UsuarioId == user.Id && m.EsActiva)
                .OrderByDescending(m => m.FechaCreacion)
                .FirstOrDefaultAsync();

            // Obtener historial de membresías
            var historialMembresias = await _context.Membresias
                .Where(m => m.UsuarioId == user.Id)
                .OrderByDescending(m => m.FechaCreacion)
                .ToListAsync();

            // Definir planes disponibles
            var planesDisponibles = ObtenerPlanesDisponibles();

            ViewBag.MembresiaActual = membresiaActual;
            ViewBag.HistorialMembresias = historialMembresias;
            ViewBag.PlanesDisponibles = planesDisponibles;

            return View();
        }

        [HttpPost]
        [ValidateAntiForgeryToken]
        public async Task<IActionResult> SuscribirPlan(string tipoPlan, string duracion)
        {
            var user = await _userManager.GetUserAsync(User);
            if (user == null)
            {
                return RedirectToAction("Login", "Account");
            }

            try
            {
                // Cancelar membresía activa si existe
                var membresiaActiva = await _context.Membresias
                    .Where(m => m.UsuarioId == user.Id && m.EsActiva)
                    .FirstOrDefaultAsync();

                if (membresiaActiva != null)
                {
                    membresiaActiva.EsActiva = false;
                    membresiaActiva.FechaCancelacion = DateTime.Now;
                    membresiaActiva.NotasCancelacion = "Cancelada automáticamente por nueva suscripción";
                }

                // Calcular precio y fechas
                var planes = ObtenerPlanesDisponibles();
                var planSeleccionado = planes.FirstOrDefault(p => p.Nombre.Equals(tipoPlan, StringComparison.OrdinalIgnoreCase));
                
                if (planSeleccionado == null)
                {
                    TempData["ErrorMessage"] = "Plan no válido seleccionado.";
                    return RedirectToAction("Index");
                }

                var precio = duracion == "anual" ? planSeleccionado.PrecioAnual : planSeleccionado.PrecioMensual;
                var meses = duracion == "anual" ? 12 : 1;

                // Crear nueva membresía
                var nuevaMembresia = new Membresia
                {
                    UsuarioId = user.Id,
                    TipoMembresia = tipoPlan,
                    Precio = precio,
                    FechaInicio = DateTime.Now,
                    FechaFin = DateTime.Now.AddMonths(meses),
                    EsActiva = true,
                    MetodoPago = "Simulado", // En producción integrar con pasarela de pago
                    TransaccionId = Guid.NewGuid().ToString().Substring(0, 8).ToUpper()
                };

                _context.Membresias.Add(nuevaMembresia);
                await _context.SaveChangesAsync();

                TempData["SuccessMessage"] = $"¡Bienvenido al plan {tipoPlan}! Tu membresía está activa.";
                return RedirectToAction("Index");
            }
            catch (Exception ex)
            {
                TempData["ErrorMessage"] = "Error al procesar la suscripción. Inténtalo de nuevo.";
                return RedirectToAction("Index");
            }
        }

        [HttpPost]
        [ValidateAntiForgeryToken]
        public async Task<IActionResult> CancelarMembresia()
        {
            var user = await _userManager.GetUserAsync(User);
            if (user == null)
            {
                return RedirectToAction("Login", "Account");
            }

            var membresiaActiva = await _context.Membresias
                .Where(m => m.UsuarioId == user.Id && m.EsActiva)
                .FirstOrDefaultAsync();

            if (membresiaActiva != null)
            {
                membresiaActiva.EsActiva = false;
                membresiaActiva.FechaCancelacion = DateTime.Now;
                membresiaActiva.NotasCancelacion = "Cancelada por el usuario";

                await _context.SaveChangesAsync();
                TempData["SuccessMessage"] = "Membresía cancelada exitosamente.";
            }
            else
            {
                TempData["ErrorMessage"] = "No tienes una membresía activa para cancelar.";
            }

            return RedirectToAction("Index");
        }

