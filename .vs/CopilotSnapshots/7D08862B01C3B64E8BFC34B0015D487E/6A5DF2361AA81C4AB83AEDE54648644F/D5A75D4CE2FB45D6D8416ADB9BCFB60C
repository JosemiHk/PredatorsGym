        [AllowAnonymous]
        [HttpPost]
        [IgnoreAntiforgeryToken]
        [Route("Membresia/Webhook")]
        public async Task<IActionResult> Webhook()
        {
            try
            {
                // Mercado Pago envía topic/type + data.id (payment id) o resource
                var topic = Request.Query["type"].FirstOrDefault() ?? Request.Query["topic"].FirstOrDefault();
                var paymentId = Request.Query["data.id"].FirstOrDefault() ?? Request.Query["id"].FirstOrDefault();

                if (string.Equals(topic, "payment", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrEmpty(paymentId))
                {
                    var payment = await _mp.GetPaymentAsync(paymentId);
                    if (payment != null && payment.Status.Equals("approved", StringComparison.OrdinalIgnoreCase))
                    {
                        // intentar obtener userId desde metadata
                        var userId = payment.Metadata?.UserId;
                        // No tenemos preference_id aquí, pero activamos por último preliminar del usuario
                        await ActivarMembresiaAsync(userId, preferenceId: null, paymentId: payment.Id);
                    }
                }
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error en webhook de Mercado Pago");
            }
            return Ok();
        }
